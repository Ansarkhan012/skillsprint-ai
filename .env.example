NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Phase 2: backend FastAPI only, for trusted processing finalization. Never NEXT_PUBLIC.
DATABASE_URL=

AI_PROVIDER=nararouter
# Backend only. agnes-2.5-flash is on the NaraRouter free plan (verified 2026-09-28);
# gemini-3.8-flash-high is pay-as-you-go (HTTP 402 without credits). See README section 3.
# A blank model/key fails provider construction; there is no automatic fallback.
NARAROUTER_API_KEY=
NARAROUTER_BASE_URL=https://router.bynara.id/v1
NARAROUTER_MODEL=agnes-2.5-flash
NARAROUTER_TIMEOUT_SECONDS=180
NARAROUTER_MAX_OUTPUT_TOKENS=16384
NARAROUTER_TEMPERATURE=0.1
# Optional: none|low|medium|high. Blank = model default. "none" is faster but free models then
# returned plans with no modules (see README), so leave blank unless generating per stage.
NARAROUTER_REASONING_EFFORT=
GEMINI_API_KEY=
GEMINI_MODEL=
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Phase 1 application configuration
API_BASE_URL=http://127.0.0.1:8000
WEB_ORIGIN=http://localhost:3000
SUPABASE_JWT_AUDIENCE=authenticated
ENVIRONMENT=development
MAX_UPLOAD_BYTES=15728640
# Set the same MAX_UPLOAD_BYTES in apps/web/.env.local for gateway request limiting.
DOCUMENT_CHUNK_CHARS=1200
DOCUMENT_CHUNK_OVERLAP=150
