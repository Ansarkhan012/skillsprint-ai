NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Phase 2: backend FastAPI only, for trusted processing finalization. Never NEXT_PUBLIC.
DATABASE_URL=

AI_PROVIDER=gemini
GEMINI_API_KEY=

# Phase 1 application configuration
API_BASE_URL=http://127.0.0.1:8000
