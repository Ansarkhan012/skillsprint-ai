NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Phase 2: backend FastAPI only, for trusted processing finalization. Never NEXT_PUBLIC.
DATABASE_URL=

AI_PROVIDER=nararouter
# Backend only. Alias discovered on 2026-09-28; recheck entitlement for another key.
# A blank model/key fails provider construction; there is no automatic fallback.
NARAROUTER_API_KEY=
NARAROUTER_BASE_URL=https://router.bynara.id/v1
NARAROUTER_MODEL=gemini-3.8-flash-high
NARAROUTER_TIMEOUT_SECONDS=30
NARAROUTER_MAX_OUTPUT_TOKENS=8192
NARAROUTER_TEMPERATURE=0.1
GEMINI_API_KEY=
GEMINI_MODEL=
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Phase 1 application configuration
API_BASE_URL=http://127.0.0.1:8000
WEB_ORIGIN=http://localhost:3000
SUPABASE_JWT_AUDIENCE=authenticated
ENVIRONMENT=development
MAX_UPLOAD_BYTES=15728640
# Set the same MAX_UPLOAD_BYTES in apps/web/.env.local for gateway request limiting.
DOCUMENT_CHUNK_CHARS=1200
DOCUMENT_CHUNK_OVERLAP=150
